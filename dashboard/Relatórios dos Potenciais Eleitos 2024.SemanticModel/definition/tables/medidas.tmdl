table medidas
	lineageTag: 7437cc7b-7363-40ac-a0d6-de204cf2d2ae

	measure 'Investimento Partido D' =
			CALCULATE(
			    SUM(f_partido_distribuicao_candidato[valor]),
			    FILTER(
			        f_partido_distribuicao_candidato,
			        f_partido_distribuicao_candidato[sigla]=[0. partido selecionado])
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Dados
		lineageTag: 4ac46af1-5e23-4e50-9fec-82d021d32637

