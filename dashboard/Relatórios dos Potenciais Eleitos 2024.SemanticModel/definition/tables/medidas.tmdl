	measure 'Qtd. Candidatos Sem Investimento' = CALCULATE(DISTINCTCOUNT(f_candidato[sq_candidato]),f_candidato[investimento]="Não")+0
		formatString: #,0
		displayFolder: Cartões
		lineageTag: 618fb7b2-5f07-40df-a782-c4d6fe134b53

	measure 'Presença de Candidatos à Observar 2022' =
			
			VAR PP = CALCULATE(DISTINCTCOUNT(f_candidato_2022[sq_candidato]), f_candidato_2022[categoria_candidatos]="Potencial Eleito") + CALCULATE(DISTINCTCOUNT(f_candidato_2022[sq_candidato]),f_candidato_2022[categoria_candidatos]="Potencial Eleito")
			VAR PD = CALCULATE(DISTINCTCOUNT(f_candidato_2022[sq_candidato]), f_candidato_2022[categoria_candidatos]="Candidato Desafiante") + CALCULATE(DISTINCTCOUNT(f_candidato_2022[sq_candidato]), f_candidato_2022[categoria_candidatos]="Possível Desafiante")
			RETURN
			IF(AND(PP>0,PP>PD),
			    2,
			    IF(OR(PD>0,PD>=PP),
			        1,0
			    ))
		formatString: 0
		displayFolder: Mapas
		lineageTag: 9ba48bc2-a8c9-4af0-bb85-c2fd9422a21f

	measure 'Possui Investimento' =
			
			var r = CALCULATE(DISTINCTCOUNT(f_candidato[sq_candidato]),f_candidato[investimento]>0)
			RETURN
			IF(r>0,"Sim", "Não")
		displayFolder: Dados
		lineageTag: b23a680f-f12c-48a3-b912-cea308106461

