	measure 'Votos Obtidos' =
			
			CALCULATE(SUM(f_candidato[tt_votos_definitivos]))
		formatString: #,0
		displayFolder: Dados
		lineageTag: 88098e0e-b1e2-4ed2-9a9f-6f1b88c277e4

	measure 'Obtidos vs Prefeito Eleito' =
			
			var d = CALCULATE(SUM(d_municipio[votos_prefeito_eleito]))
			RETURN
			   DIVIDE([Votos Obtidos],d)
		formatString: 0.00%;-0.00%;0.00%
