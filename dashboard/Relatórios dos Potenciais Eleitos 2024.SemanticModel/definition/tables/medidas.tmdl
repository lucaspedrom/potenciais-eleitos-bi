	measure teto_gastos =
			
			var c = SELECTEDVALUE(f_candidato[ds_cargo])
			var f = SELECTEDVALUE(f_candidato[fase])
			
			RETURN
			SWITCH(TRUE(),
			    c="Vereador",CALCULATE(SUM(d_municipio[teto_gastos_vereador])),
			    c="Prefeito" && f="Primeiro Turno",CALCULATE(SUM(d_municipio[teto_gastos_prefeito_1t])),
			    c="Prefeito" && f="Segundo Turno",CALCULATE(SUM(d_municipio[teto_gastos_prefeito_1t]))+CALCULATE(SUM(d_municipio[teto_gastos_prefeito_2t]))
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Dados
		lineageTag: dd5fe1e9-93cc-42fa-a812-fce464811542

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

