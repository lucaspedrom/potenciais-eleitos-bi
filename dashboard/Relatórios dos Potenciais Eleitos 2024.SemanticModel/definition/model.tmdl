model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Medidas

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Tabelas Fato'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Tabelas Dimensão'

	annotation PBI_QueryGroupOrder = 2

queryGroup Parâmetros

	annotation PBI_QueryGroupOrder = 3

annotation PBI_QueryOrder = ["CaminhoDados","d_estados","d_faixa_populacao","d_municipio","d_partidos","f_candidato","f_candidato_2022","f_candidato_2022_suporte","f_candidato_suporte","f_partido_distribuicao_candidato","f_partido_distribuicao_candidato_2022","f_prestacao_contas","f_votacao_candidato","medidas"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table f_votacao_candidato
ref table f_prestacao_contas
ref table d_municipio
ref table d_partidos
ref table medidas
ref table f_candidato
ref table d_faixa_populacao
